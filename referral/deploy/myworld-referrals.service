[Unit]
Description=MyWorld referral landing and private owner cabinet
After=network-online.target
[Service]
User=myworldref
Group=myworldref
WorkingDirectory=/opt/myworld-referrals
EnvironmentFile=/etc/myworld-referrals.env
ExecStart=/usr/bin/node /opt/myworld-referrals/referral/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myworld-referrals
UMask=0077
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
