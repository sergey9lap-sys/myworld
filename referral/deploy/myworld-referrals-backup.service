[Unit]
Description=Closed SQLite backup for MyWorld referrals
[Service]
Type=oneshot
User=myworldref
Group=myworldref
ExecStart=/usr/bin/node /opt/myworld-referrals/referral/deploy/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/myworld-referrals /var/backups/myworld-referrals
UMask=0077
